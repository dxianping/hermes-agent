-        state = "auto" if policy == "auto" else (
+        state = policy if policy in ("auto", "all") else (
             f"inactive — set mcp_servers.{row['server']}.skills.trust: auto to apply")
         print(f"{row['server']}  {row['uri']}")
         print(f"    name: {row.get('name') or '—'}   "

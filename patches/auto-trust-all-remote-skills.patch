diff --git a/tools/mcp_skills_trust.py b/tools/mcp_skills_trust.py
index 19fcce1be4..a785603b57 100644
--- a/tools/mcp_skills_trust.py
+++ b/tools/mcp_skills_trust.py
@@ -12,6 +12,11 @@ The recorded manifest fingerprint is informational (shown by ``hermes skills tru
 by design a content update does not revoke trust — the server is the trusted identity, and
 every served manifest still goes through the scan chain. Removing the record or setting the
 policy back to ``prompt`` re-blocks the next gate call; auto approvals are never cached.
+
+INSTALL-BRANCH VARIANT (see the ``installer`` branch): a server this profile lists in
+``mcp_servers`` is blanket-trusted by default ("all") — every skill it serves auto-approves
+activation and host execution with no per-skill record. ``trust: prompt`` opts a server back
+into human consent; ``trust: auto`` keeps the record-gated behavior.
 """
 from __future__ import annotations
 
@@ -64,19 +69,23 @@ def _write_rows(home_key: str, rows: dict[tuple[str, str], dict[str, Any]]) -> N
 
 
 def trust_policy(server: str) -> str:
-    """``mcp_servers.<server>.skills.trust`` from the USER's config: ``"auto"`` or ``"prompt"``.
+    """``mcp_servers.<server>.skills.trust`` from the USER's config: "auto", "all" or "prompt".
 
-    Read through the merged user config (never the plugin/portable-server merge in
-    ``mcp_tool_config._load_mcp_config``) so a package can never widen trust; anything
-    unreadable or unrecognized fails closed to ``"prompt"``.
+    INSTALL-BRANCH VARIANT: a server this profile configures is blanket-trusted by default
+    ("all"); an unconfigured server fails closed to "prompt". Read through the merged user
+    config (never the plugin/portable-server merge in ``mcp_tool_config._load_mcp_config``)
+    so a package can never widen trust; anything unreadable or unrecognized is "prompt".
     """
     from hermes_cli.config import load_config_readonly
     try:
         servers = load_config_readonly().get("mcp_servers")
         entry = servers.get(server) if isinstance(servers, dict) else None
-        skills = entry.get("skills") if isinstance(entry, dict) else None
+        if not isinstance(entry, dict):
+            return "prompt"
+        skills = entry.get("skills")
         value = skills.get("trust", MCP_SKILLS_DEFAULTS["trust"]) if isinstance(skills, dict) else None
-        return "auto" if isinstance(value, str) and value.strip().lower() == "auto" else "prompt"
+        text = value.strip().lower() if isinstance(value, str) else ""
+        return text if text in ("auto", "all") else "prompt"
     except Exception:  # fail closed: any config-read failure means "prompt"
         logger.debug("Could not read MCP skills trust policy for %r", server, exc_info=True)
         return "prompt"
@@ -90,10 +99,16 @@ def is_origin_trusted(server: str, uri: str, home: Path | str | None = None) ->
 
 
 def origin_auto_trusted(record: dict[str, Any], home: Path | str | None = None) -> bool:
-    """``is_origin_trusted`` for a pinned record, gated by the per-server config opt-in."""
+    """Auto-approval check for a pinned record, gated by the per-server config policy.
+
+    INSTALL-BRANCH VARIANT: "all" (the configured-server default) trusts every URI the
+    server serves; "auto" keeps the ``hermes skills trust-mcp`` record requirement.
+    """
     server = record.get("server") or ""
-    uri = record.get("uri") or ""
-    return trust_policy(server) == "auto" and is_origin_trusted(server, uri, home)
+    policy = trust_policy(server)
+    if policy == "all":
+        return True
+    return policy == "auto" and is_origin_trusted(server, record.get("uri") or "", home)
 
 
 def record_trust(server: str, uri: str, *, home: Path | str | None = None, name: str = "",
